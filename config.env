# Single-node OKD (community OpenShift) lab defaults for VirtualBox.
# Copy to config.local.env to override without editing this file.
# Official SNO minimum: 8 vCPU / 16 GB RAM / 120 GB disk.

# OKD release: https://github.com/okd-project/okd/releases
OKD_VERSION="${OKD_VERSION:-4.22.0-okd-scos.8}"

CLUSTER_NAME="${CLUSTER_NAME:-okd}"
# sslip.io resolves any name that contains the node IP, including the
# wildcard *.apps.<cluster>.<ip>.sslip.io records OpenShift requires.
# Set DNS_MODE=dnsmasq and BASE_DOMAIN=lab if you prefer a private zone.
DNS_MODE="${DNS_MODE:-sslip}"
BASE_DOMAIN="${BASE_DOMAIN:-}"

NETWORK_CIDR="${NETWORK_CIDR:-192.168.56.0/24}"
HOST_IP="${HOST_IP:-192.168.56.1}"
SNO_IP="${SNO_IP:-192.168.56.20}"
SNO_HOSTNAME="${SNO_HOSTNAME:-}"

VM_NAME="${VM_NAME:-okd-sno}"
VM_CPUS="${VM_CPUS:-8}"
VM_MEMORY_MB="${VM_MEMORY_MB:-16384}"
VM_DISK_GB="${VM_DISK_GB:-120}"
VM_OSTYPE="${VM_OSTYPE:-RedHat_64}"

# VirtualBox Intel PRO/1000 NICs show up as enp0s3 (nic1) and enp0s8 (nic2).
HOSTONLY_NIC="${HOSTONLY_NIC:-enp0s3}"
NAT_NIC="${NAT_NIC:-enp0s8}"
HOSTONLY_MAC="${HOSTONLY_MAC:-02:00:00:56:00:20}"
NAT_MAC="${NAT_MAC:-02:00:00:02:00:20}"
# VirtualBox NAT DHCP typically assigns 10.0.2.15; gateway is 10.0.2.2.
NAT_GATEWAY="${NAT_GATEWAY:-10.0.2.2}"

# Keep the test node lean. Set FULL_CAPABILITIES=true for a stock operator set.
FULL_CAPABILITIES="${FULL_CAPABILITIES:-false}"
